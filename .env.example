# Copia este archivo como .env.local y ajusta los valores.

# Base de la API que usa el navegador. En desarrollo se deja en /api/v1 para pasar
# por el proxy de Vite (el backend no tiene CORS).
VITE_API_BASE_URL=/api/v1

# Destino del proxy de Vite en `pnpm dev`: el backend Go en WSL (HTTP_ADDR=:8080).
VITE_BACKEND_URL=http://localhost:8080
