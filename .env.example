# Copia este archivo como .env.local y ajusta los valores.

# Base de la API que usa el navegador.
# - /api/v1 (por defecto): pasa por el proxy de Vite; funciona en cualquier puerto.
# - http://localhost:8080/api/v1: llamada directa al backend usando su CORS. Solo funciona
#   si el origen del frontend está en CORS_ALLOWED_ORIGINS del backend
#   (por defecto http://localhost:5173).
VITE_API_BASE_URL=/api/v1

# Destino del proxy de Vite en `pnpm dev`: el backend Go en WSL (HTTP_ADDR=:8080).
VITE_BACKEND_URL=http://localhost:8080
# El modo Kubernetes del backend (puerto 80) se retiró en el commit 1c7b308 del backend.

# Client ID PÚBLICO de la app de Spotify (Authorization Code + PKCE, sin secreto).
# Vinculación con Spotify (PKCE, sin secreto) desde Configuración. En el panel de Spotify, la
# Redirect URI debe ser http://127.0.0.1:5173/spotify/callback y Junkbox debe abrirse en
# http://127.0.0.1:5173 para vincular (Spotify no acepta localhost).
VITE_SPOTIFY_CLIENT_ID=
# Solo si se registra otra URL de retorno:
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback
