# Copia este archivo como .env.local y ajusta los valores.

# Base de la API que usa el navegador.
# - /api/v1 (por defecto): pasa por el proxy de Vite; funciona en cualquier puerto.
# - http://localhost:8080/api/v1: llamada directa al backend usando su CORS. Solo funciona
#   si el origen del frontend está en CORS_ALLOWED_ORIGINS del backend
#   (por defecto http://localhost:5173).
VITE_API_BASE_URL=/api/v1

# Destino del proxy de Vite en `pnpm dev`: el backend Go en WSL (HTTP_ADDR=:8080).
VITE_BACKEND_URL=http://localhost:8080
